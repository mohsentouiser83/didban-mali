{
  "name": "didban-mali-rebuild",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/api-client"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @didban/web",
    "build": "npm run build --workspace @didban/web",
    "start": "npm run start --workspace @didban/web",
    "typecheck": "npm run typecheck --workspace @didban/web",
    "lint": "npm run lint --workspace @didban/web",
    "generate:api": "openapi-typescript contracts/openapi.json -o packages/api-client/schema.ts",
    "test:client": "tsx --tsconfig apps/web/tsconfig.json --test tests/api-client.test.ts tests/dates.test.ts tests/format-values.test.ts tests/financial-ui.test.ts tests/processing-progress.test.ts tests/payroll-preview.test.ts",
    "check:api": "openapi-typescript contracts/openapi.json -o packages/api-client/schema.ts --check"
  },
  "devDependencies": {
    "openapi-typescript": "7.10.1",
    "prettier": "3.9.9",
    "tsx": "4.20.6"
  }
}
