# Install only after replacing didban.example.org and certificate paths.
# The application remains bound to loopback. Do not publish the API port.
server {
    listen 80;
    server_name didban.example.org;
    return 308 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name didban.example.org;
    ssl_certificate /etc/didban/tls/fullchain.pem;
    ssl_certificate_key /etc/didban/tls/privatekey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:didban_tls:10m;
    ssl_session_tickets off;
    client_max_body_size 21m;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    # Enable HSTS only after HTTPS and the organization's host name are verified.
    location / {
        proxy_pass http://127.0.0.1:18148;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 90s;
    }
}
