# Local Compose setup only. Generate the four blank values before starting.
DIDBAN_DB_NAME=didban
DIDBAN_DB_ADMIN_USER=didban_migrator
DIDBAN_DB_ADMIN_PASSWORD=
DIDBAN_APP_DB_USER=didban_runtime_login
DIDBAN_APP_DB_PASSWORD=
DIDBAN_IDENTITY_DB_USER=didban_identity_login
DIDBAN_IDENTITY_DB_PASSWORD=
DIDBAN_WORKER_DB_USER=didban_worker_login
DIDBAN_WORKER_DB_PASSWORD=
DIDBAN_SECRET=
DIDBAN_PUBLIC_ORIGIN=http://127.0.0.1:18148
DIDBAN_COOKIE_SECURE=false
DIDBAN_HTTP_PORT=18147
DIDBAN_WEB_PORT=18148
# Optional public package mirror for image build; no private credentials here.
PIP_INDEX_URL=https://pypi.org/simple
NPM_REGISTRY=https://registry.npmjs.org

# Optional server-only provider. Leave blank until real ID, tariff and installation cap are configured.
DIDBAN_MODEL_PROVIDER=openai
DIDBAN_MODEL_API_KEY=
DIDBAN_MODEL_ID=
DIDBAN_MODEL_ALLOWED_IDS=
DIDBAN_MODEL_INPUT_USD_PER_MILLION=
DIDBAN_MODEL_OUTPUT_USD_PER_MILLION=
DIDBAN_MODEL_MAX_OUTPUT_TOKENS=512
DIDBAN_MODEL_TIMEOUT_SECONDS=30
# Optional; for gpt-6-luna a small classification request can use none.
DIDBAN_MODEL_REASONING_EFFORT=
# Enable after model budget and source-proposal controls are configured.
DIDBAN_MODEL_INTAKE_ENABLED=false
