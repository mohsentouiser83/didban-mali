# Local development. Existing legacy .env is preserved only in the sibling backup.
DIDBAN_DATABASE_URL=sqlite:///./var/didban.db
DIDBAN_WEB_ORIGIN=http://127.0.0.1:3000
DIDBAN_PRODUCTION=false
DIDBAN_API_URL=http://127.0.0.1:8000
# Optional local ClamAV; production requires scanning and PostgreSQL.
# DIDBAN_SCANNER_HOST=127.0.0.1
# DIDBAN_SCANNER_PORT=3310
# Docker Compose: set DIDBAN_WEB_ORIGIN to your HTTPS TLS proxy origin.
# Generate separate random passwords; URL-encode reserved URL characters.
# DIDBAN_POSTGRES_ADMIN_PASSWORD=
# DIDBAN_APP_DB_PASSWORD=

# Model adapter remains disabled until the installation explicitly configures all budgets/tariffs.
DIDBAN_MODEL_PROVIDER=AvalAI
DIDBAN_MODEL_ENABLED=false
# Explicit temporary installation-wide override; usage accounting stays enabled.
DIDBAN_MODEL_BUDGET_UNLIMITED=false
# DIDBAN_OPENAI_API_KEY=

# Optional speech-to-text, separately enabled and billed by the provider.
# It does not use the structured-text model tariff/reservation ledger.
DIDBAN_VOICE_ENABLED=false
# Select a transcription model supported by DIDBAN_MODEL_PROVIDER.
# AvalAI example: groq.whisper-large-v3 (verify availability before enabling).
DIDBAN_VOICE_MODEL=

# Optional private-chat bots. Tokens/secrets stay on the API server.
DIDBAN_BOTS_ENABLED=false
# DIDBAN_TELEGRAM_BOT_TOKEN=
# DIDBAN_TELEGRAM_WEBHOOK_SECRET=
# DIDBAN_TELEGRAM_BOT_USERNAME=example_bot
# DIDBAN_BALE_BOT_TOKEN=
# DIDBAN_BALE_WEBHOOK_SECRET=
# DIDBAN_BALE_BOT_USERNAME=example_bot
# Generate an independent URL-safe random webhook secret (at least 32 characters)
# for each provider. Never commit secrets or paste them into chat.
